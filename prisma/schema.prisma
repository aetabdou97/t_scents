generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Produit {
  id          Int      @id @default(autoincrement())
  nom         String
  description String
  notes       String
  prix        Float
  categorie   String   // homme, femme, mixte
  formats     String   // "15ml, 30ml"
  imageUrl    String?
  disponible  Boolean  @default(true)
}
